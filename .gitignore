hs_err_pid*
replay_pid*

source/*
!source/README.md
dataframe/*
!dataframe/README.md
!dataframe/hashes_list.csv
!dataframe/masks_list.csv
!dataframe/ip_list.csv
!dataframe/address_blacklist.csv

# Runtime SQLite stores (created with relative paths when the app/tests run
# from a module dir); never tracked.
**/dataframe/*.db
**/ioc-dataframe.db
**/ioc-service.db
bootstrap/ioc-app/dataframe/
bootstrap/ioc-app/var/

.envrc

.vscode

CLAUDE.md
AGENTS.md
.claude
.codex
**/__pycache__/
*.py[cod]

# Local design/work notes are scratch context, not published project documentation.
/docs/worknote/*

# The 0.3.0 release execution bundle is version-controlled as non-published
# planning and evidence. Other worknotes remain local by default.
!/docs/worknote/0.3.0/
!/docs/worknote/0.3.0/**
# The release worknote may contain isolated Maven qualification probes.
# Keep their reproducible sources, but never version their generated output.
/docs/worknote/0.3.0/**/target/

# Qualification measurements stay local; summaries and reproducible probes are versioned.
/docs/worknote/0.3.0/**/qualification/**/*.csv
/docs/worknote/0.3.0/**/qualification/**/*.gz
/docs/worknote/0.3.0/**/qualification/**/*.jfr
/docs/worknote/0.3.0/**/qualification/**/*.json
/docs/worknote/0.3.0/**/qualification/**/*.jsonl
/docs/worknote/0.3.0/**/qualification/**/*.metadata
/docs/worknote/0.3.0/**/qualification/**/*.txt
/docs/worknote/0.3.0/**/qualification/**/*-focused.xml
# Per-sample rendered policies are generated measurement state, not source fixtures.
/docs/worknote/0.3.0/**/qualification/**/[0-9]*/application.yml
