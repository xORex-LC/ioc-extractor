# Build output
target/
.idea/
*.iml

# Generated artifacts
dataframe/*_generated.csv

# Compiled class file
*.class

# Log file
*.log
*.ecs.json
/var/
/.dev/
/.dependency-check-data/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

source/*
!source/README.md
dataframe/*
!dataframe/README.md
!dataframe/hashes_list.csv
!dataframe/masks_list.csv
!dataframe/ip_list.csv
!dataframe/address_blacklist.csv

# Runtime SQLite stores (created with relative paths when the app/tests run
# from a module dir); never tracked.
**/dataframe/*.db
**/ioc-dataframe.db
**/ioc-service.db
bootstrap/ioc-app/dataframe/
bootstrap/ioc-app/var/

.envrc

.vscode

CLAUDE.md
AGENTS.md
.claude
.codex
**/__pycache__/
*.py[cod]

# Local design/work notes are scratch context, not published project documentation.
/docs/worknote/*

# Keep only the active 0.3.0 roadmap; qualification records live in
# .github/release-evidence and durable contracts in the owning documentation.
!/docs/worknote/0.3.0/
/docs/worknote/0.3.0/*
!/docs/worknote/0.3.0/engineering-release.md
!/docs/worknote/0.3.0/execution-model.md
!/docs/worknote/0.3.0/status-matrix.md
!/docs/worknote/0.3.0/goals/
/docs/worknote/0.3.0/goals/*
!/docs/worknote/0.3.0/goals/R030-*.md
!/docs/worknote/0.3.0/documentation/
/docs/worknote/0.3.0/documentation/*
!/docs/worknote/0.3.0/documentation/remaining-work.tsv
