# Build output
target/
.idea/
*.iml

# Generated artifacts
dataframe/*_generated.csv

# Compiled class file
*.class

# Log file
*.log
*.ecs.json
/var/
/.dev/
/.dependency-check-data/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

