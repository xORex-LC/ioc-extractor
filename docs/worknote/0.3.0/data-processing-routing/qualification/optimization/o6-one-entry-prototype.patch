diff --git a/adapters/adapter-processing-camel/src/main/java/com/iocextractor/adapter/processing/camel/runtime/LocalViewRoute.java b/adapters/adapter-processing-camel/src/main/java/com/iocextractor/adapter/processing/camel/runtime/LocalViewRoute.java
