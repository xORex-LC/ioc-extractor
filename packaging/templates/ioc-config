#!/usr/bin/env bash
# Validates and atomically applies the installed operator YAML.
set -Eeuo pipefail

SERVICE="ioc-extractor"
PREFIX="@PREFIX@"
JAVA_BIN="@JAVA_BIN@"
RUN_USER="@USER@"
RUN_GROUP="@GROUP@"
SERVER_PORT="@SERVER_PORT@"
TARGET="${PREFIX}/etc/application.yml"
LOCK="/run/lock/ioc-extractor-config.lock"
HEALTH_ATTEMPTS=40
HEALTH_INTERVAL=1
STAGED_FILE=""
CONFIG_CHECK_SEQUENCE=0

log() { printf '[ioc-config] %s\n' "$*"; }
die() { printf '[ioc-config] error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage:
  sudo ${PREFIX}/bin/ioc-config check [candidate.yml]
  sudo ${PREFIX}/bin/ioc-config apply <candidate.yml>

check performs strict binding and semantic validation in a configuration-only
Spring context without composing runtime adapters or touching runtime state.
apply validates a separate candidate, atomically replaces application.yml,
restarts the service, and restores the previous file if health does not become UP.
EOF
}

cleanup() {
  [[ -z "${STAGED_FILE}" || ! -e "${STAGED_FILE}" ]] || rm -f -- "${STAGED_FILE}"
}
trap cleanup EXIT

validate_config() {
  local file="$1" unit
  CONFIG_CHECK_SEQUENCE=$((CONFIG_CHECK_SEQUENCE + 1))
  unit="ioc-extractor-config-check-$$-${CONFIG_CHECK_SEQUENCE}"
  systemd-run --quiet --wait --pipe --collect \
    --unit="${unit}" \
    --property=Type=exec \
    --property="User=${RUN_USER}" \
    --property="Group=${RUN_GROUP}" \
    --property="WorkingDirectory=${PREFIX}" \
    --property="EnvironmentFile=${PREFIX}/etc/ioc-extractor.env" \
    --property=NoNewPrivileges=true \
    --property=ProtectSystem=strict \
    --property=ProtectHome=true \
    --property=PrivateTmp=true \
    "${JAVA_BIN}" "\$JAVA_OPTS" -Xms32m -Xmx128m \
    -Duser.timezone=UTC -Dfile.encoding=UTF-8 \
    -jar "${PREFIX}/current/ioc-app.jar" "--ioc.validate-config=${file}" \
    --ioc.runtime.mode=daemon
}

stage_candidate() {
  local candidate="$1"
  # Spring selects a PropertySourceLoader from the filename extension. Keep a
  # real YAML suffix on the service-readable staged copy; a random suffix after
  # `.yml` makes an otherwise valid candidate unrecognizable to the loader.
  STAGED_FILE="$(mktemp --suffix=.yml "${PREFIX}/etc/.application.candidate.XXXXXX")"
  install -o root -g "${RUN_GROUP}" -m 0640 "${candidate}" "${STAGED_FILE}"
}

health_ready() {
  local body
  body="$(curl --noproxy '*' --silent --fail --max-time 2 \
    "http://127.0.0.1:${SERVER_PORT}/actuator/health" 2>/dev/null)" || return 1
  grep -Eq '"status"[[:space:]]*:[[:space:]]*"UP"' <<< "${body}"
}

wait_for_health() {
  local attempt
  for ((attempt = 1; attempt <= HEALTH_ATTEMPTS; attempt++)); do
    systemctl is-active --quiet "${SERVICE}" && health_ready && return 0
    (( attempt == HEALTH_ATTEMPTS )) || sleep "${HEALTH_INTERVAL}"
  done
  return 1
}

atomic_restore() {
  local backup="$1" restore
  restore="$(mktemp "${PREFIX}/etc/.application.yml.restore.XXXXXX")"
  cp -a -- "${backup}" "${restore}"
  mv -f -- "${restore}" "${TARGET}"
}

[[ "${EUID}" -eq 0 ]] || die "run this command through sudo"
[[ $# -ge 1 ]] || { usage; exit 2; }

case "$1" in
  check)
    [[ $# -le 2 ]] || die "check accepts at most one file"
    candidate="${2:-${TARGET}}"
    [[ -f "${candidate}" && ! -L "${candidate}" ]] \
      || die "candidate must be a regular non-symlink file: ${candidate}"
    stage_candidate "$(realpath "${candidate}")"
    validate_config "${STAGED_FILE}"
    ;;
  apply)
    [[ $# -eq 2 ]] || die "apply requires exactly one candidate file"
    candidate="$2"
    [[ -f "${candidate}" && ! -L "${candidate}" ]] \
      || die "candidate must be a regular non-symlink file: ${candidate}"
    candidate="$(realpath "${candidate}")"
    [[ "${candidate}" != "$(realpath "${TARGET}")" ]] \
      || die "edit a separate candidate; refusing to apply the live file to itself"

    exec 9>"${LOCK}"
    flock -n 9 || die "another configuration apply is already running"
    stage_candidate "${candidate}"
    validate_config "${STAGED_FILE}"

    stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
    backup="${PREFIX}/etc/application.yml.backup-${stamp}"
    rejected="${PREFIX}/etc/application.yml.rejected-${stamp}"
    cp -a -- "${TARGET}" "${backup}"
    mv -f -- "${STAGED_FILE}" "${TARGET}"
    STAGED_FILE=""

    systemctl reset-failed "${SERVICE}" || true
    if systemctl restart "${SERVICE}" && wait_for_health; then
      log "applied atomically; service is UP"
      log "previous configuration: ${backup}"
      exit 0
    fi

    log "candidate did not become healthy; restoring previous configuration"
    mv -f -- "${TARGET}" "${rejected}"
    atomic_restore "${backup}"
    systemctl reset-failed "${SERVICE}" || true
    if systemctl restart "${SERVICE}" && wait_for_health; then
      log "rollback completed; previous service is UP"
    else
      log "rollback file was restored, but the previous service is not healthy"
    fi
    log "rejected candidate preserved at: ${rejected}"
    exit 1
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    die "unknown command: $1"
    ;;
esac
