<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.iocextractor</groupId>
    <artifactId>ioc-extractor-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>ioc-extractor-parent</name>
    <description>Parent reactor for the IOC extractor: dependency/plugin management and module aggregation</description>

    <properties>
        <revision>0.3.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <tomcat.version>11.0.24</tomcat.version>
        <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <picocli.version>4.7.6</picocli.version>
        <re2j.version>1.8</re2j.version>
        <tika.version>3.3.2</tika.version>
        <bouncycastle.version>1.84</bouncycastle.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <dependency-check.version>12.2.2</dependency-check.version>
        <jacoco.version>0.8.15</jacoco.version>
        <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
        <spotbugs.version>4.10.3</spotbugs.version>
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <commons-csv.version>1.12.0</commons-csv.version>
        <commons-io.version>2.22.0</commons-io.version>
        <guava.version>33.3.1-jre</guava.version>
        <archunit.version>1.3.0</archunit.version>
        <sqlite-jdbc.version>3.53.2.0</sqlite-jdbc.version>
        <smbj.version>0.14.0</smbj.version>
    </properties>

    <modules>
        <module>platform/platform-errors</module>
        <module>platform/platform-diagnostics</module>
        <module>platform/platform-etl</module>
        <module>platform/platform-events</module>
        <module>platform/platform-concurrency</module>
        <module>platform/platform-observability</module>
        <module>platform/platform-diagnostics-logging</module>
        <module>core/ioc-domain</module>
        <module>core/ioc-application</module>
        <module>core/ioc-application-tck</module>
        <module>adapters/adapter-regex-re2j</module>
        <module>adapters/adapter-psl</module>
        <module>adapters/adapter-source-tika</module>
        <module>adapters/adapter-sink-csv</module>
        <module>adapters/adapter-manifest-json-jackson</module>
        <module>adapters/adapter-store-jdbc</module>
        <module>adapters/adapter-transport-smb</module>
        <module>adapters/adapter-ingest</module>
        <module>adapters/adapter-cli-picocli</module>
        <module>bootstrap/ioc-app</module>
        <module>build-support/coverage-report</module>
        <module>build-support/spotbugs-report</module>
    </modules>

    <!-- Test stack shared by every module. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Report-only coverage bootstrap. Thresholds are introduced only after baseline acceptance. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-coverage-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>create-module-coverage-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Verify-phase order is deliberate: SpotBugs analysis must precede
                AntRun HTML/report-integrity work, and report plugins must precede
                final Enforcer integrity rules.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>${spotbugs.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>analyze-production-bytecode</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>spotbugs</goal>
                        </goals>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <includeTests>false</includeTests>
                            <failOnError>true</failOnError>
                            <skipEmptyReport>false</skipEmptyReport>
                            <htmlOutput>false</htmlOutput>
                            <xmlOutput>false</xmlOutput>
                            <outputDirectory>${project.build.directory}/spotbugs</outputDirectory>
                            <spotbugsXmlOutputDirectory>${project.build.directory}/spotbugs</spotbugsXmlOutputDirectory>
                            <spotbugsXmlOutputFilename>spotbugs.xml</spotbugsXmlOutputFilename>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Keep after SpotBugs: clean stale output early, then render/validate current reports. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>${spotbugs.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>clean-stale-spotbugs-output</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.directory}/spotbugs/spotbugs.xml"
                                        quiet="true"/>
                                <delete file="${project.build.directory}/spotbugs/spotbugs.html"
                                        quiet="true"/>
                                <delete file="${project.reporting.outputDirectory}/spotbugs.html"
                                        quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>render-spotbugs-html</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <xslt destdir="${project.build.directory}"
                                      extension=".html"
                                      failOnNoResources="false"
                                      useImplicitFileset="false"
                                      force="true">
                                    <fileset dir="${project.build.directory}"
                                             includes="spotbugs/spotbugs.xml"
                                             erroronmissingdir="false"/>
                                    <style>
                                        <javaresource name="default.xsl"
                                                      classpathref="maven.plugin.classpath"/>
                                    </style>
                                </xslt>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Keep last among quality plugins so child integrity executions see completed reports. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-hygiene</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Explicit release/scheduled security gate; intentionally not bound to the regular lifecycle. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
                    <failBuildOnUnusedSuppressionRule>true</failBuildOnUnusedSuppressionRule>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules: version aligned with the reactor. -->
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-errors</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-diagnostics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-etl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-concurrency</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-diagnostics-logging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-application-tck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-regex-re2j</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-psl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-source-tika</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-sink-csv</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-manifest-json-jackson</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-store-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-transport-smb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-ingest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-cli-picocli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-app</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- External libraries: versions centralized here, used without version in modules. -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-spring-boot-starter</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.re2j</groupId>
                <artifactId>re2j</artifactId>
                <version>${re2j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-core</artifactId>
                <version>${tika.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-parsers-standard-package</artifactId>
                <version>${tika.version}</version>
            </dependency>
            <!-- SMBJ 0.14.0 requests bcprov 1.79 while Tika 3.3.1 uses the 1.84 family;
                 keep one compatible line. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcjmail-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <!-- Tika 3.3.1 pins PDFBox 3.0.7; align the complete PDFBox 3.x family on the fixed 3.0.8 line. -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox-io</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>fontbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox-tools</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>xmpbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
