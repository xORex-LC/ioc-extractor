<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.iocextractor</groupId>
    <artifactId>ioc-extractor-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>ioc-extractor-parent</name>
    <description>Parent reactor for the IOC extractor: dependency/plugin management and module aggregation</description>

    <properties>
        <revision>0.3.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <tomcat.version>11.0.24</tomcat.version>
        <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <picocli.version>4.7.6</picocli.version>
        <re2j.version>1.8</re2j.version>
        <tika.version>3.3.2</tika.version>
        <bouncycastle.version>1.84</bouncycastle.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <dependency-check.version>12.2.2</dependency-check.version>
        <jacoco.version>0.8.15</jacoco.version>
        <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
        <spotbugs.version>4.10.3</spotbugs.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <pmd.version>7.26.0</pmd.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <pitest.version>1.30.0</pitest.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
        <commons-csv.version>1.12.0</commons-csv.version>
        <commons-io.version>2.22.0</commons-io.version>
        <guava.version>33.3.1-jre</guava.version>
        <archunit.version>1.3.0</archunit.version>
        <sqlite-jdbc.version>3.53.2.0</sqlite-jdbc.version>
        <smbj.version>0.14.0</smbj.version>
    </properties>

    <modules>
        <module>platform/platform-errors</module>
        <module>platform/platform-diagnostics</module>
        <module>platform/platform-etl</module>
        <module>platform/platform-events</module>
        <module>platform/platform-concurrency</module>
        <module>platform/platform-observability</module>
        <module>platform/platform-diagnostics-logging</module>
        <module>core/ioc-domain</module>
        <module>core/ioc-application</module>
        <module>core/ioc-application-tck</module>
        <module>adapters/adapter-regex-re2j</module>
        <module>adapters/adapter-psl</module>
        <module>adapters/adapter-source-tika</module>
        <module>adapters/adapter-csv</module>
        <module>adapters/adapter-manifest-json-jackson</module>
        <module>adapters/adapter-store-jdbc</module>
        <module>adapters/adapter-transport-smb</module>
        <module>adapters/adapter-ingest</module>
        <module>adapters/adapter-cli-picocli</module>
        <module>bootstrap/ioc-app</module>
        <module>build-support/coverage-report</module>
        <module>build-support/spotbugs-report</module>
        <module>build-support/cpd-report</module>
        <module>build-support/pmd-report</module>
    </modules>

    <!-- Test stack shared by every module. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Pinned for the opt-in dependency-analysis profile and direct CLI goals. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Naming owns lifecycle selection; JUnit tags remain descriptive metadata. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <id>default</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Coverage agent/reports; project-owned aggregate ratchets run in coverage-report. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-coverage-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- Surefire and Failsafe use separate JVMs; retain both executions. -->
                            <append>true</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>create-module-coverage-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Verify-phase order is deliberate: SpotBugs analysis must precede
                AntRun HTML/report-integrity work, and report plugins must precede
                final Enforcer integrity rules.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>${spotbugs.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>analyze-production-bytecode</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>spotbugs</goal>
                        </goals>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <includeTests>false</includeTests>
                            <failOnError>true</failOnError>
                            <skipEmptyReport>false</skipEmptyReport>
                            <htmlOutput>false</htmlOutput>
                            <xmlOutput>false</xmlOutput>
                            <outputDirectory>${project.build.directory}/spotbugs-raw</outputDirectory>
                            <spotbugsXmlOutputDirectory>${project.build.directory}/spotbugs-raw</spotbugsXmlOutputDirectory>
                            <spotbugsXmlOutputFilename>spotbugs-raw.xml</spotbugsXmlOutputFilename>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Keep before AntRun: final CPD/PMD verifiers consume this plugin's report outputs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Keep after SpotBugs and PMD so verify executions consume current analyzer outputs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>${spotbugs.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>validate-build-quality-contracts</id>
                        <phase>validate</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!--
                                  Root-only fail-fast gate: compile the JDK-only verifier and its
                                  synthetic-reactor contract tests once, then reconcile both
                                  analyzer manifests before any child project is built.
                                -->
                                <delete dir="${project.build.directory}/build-quality-verifier"
                                        quiet="true"/>
                                <mkdir dir="${project.build.directory}/build-quality-verifier"/>
                                <javac destdir="${project.build.directory}/build-quality-verifier"
                                       release="${java.version}"
                                       encoding="UTF-8"
                                       includeantruntime="false">
                                    <src path="${maven.multiModuleProjectDirectory}/build-support/build-quality"/>
                                    <src path="${maven.multiModuleProjectDirectory}/build-support/coverage-report"/>
                                    <src path="${maven.multiModuleProjectDirectory}/build-support/test-quality"/>
                                </javac>
                                <java classname="BuildQualityVerifierTest"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                </java>
                                <java classname="SpotBugsBaselineVerifierTest"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                </java>
                                <java classname="TestLifecycleVerifierTest"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                </java>
                                <java classname="CoverageVerifierTest"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                </java>
                                <java classname="TestLifecycleVerifier"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                    <arg value="validate"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/test-quality/test-lifecycle.properties"/>
                                </java>
                                <java classname="CoverageVerifier"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                    <arg value="validate"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/coverage-report/coverage-scope.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/coverage-report/coverage-ratchets.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/coverage-report/coverage-floors.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/coverage-report/pom.xml"/>
                                </java>
                                <java classname="BuildQualityVerifier"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                    <arg value="spotbugs"/>
                                    <arg value="validate"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/spotbugs-report/spotbugs-scope.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/spotbugs-report/pom.xml"/>
                                </java>
                                <java classname="SpotBugsBaselineVerifier"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                    <arg value="validate"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/spotbugs-report/spotbugs-scope.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/spotbugs-report/spotbugs-accepted-findings.xml"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/target/build-quality/spotbugs-accepted-filter.xml"/>
                                </java>
                                <java classname="BuildQualityVerifier"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                    <arg value="cpd"/>
                                    <arg value="validate"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/cpd-report/cpd-scope.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/cpd-report/pom.xml"/>
                                </java>
                                <java classname="BuildQualityVerifier"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/build-quality-verifier"/>
                                    </classpath>
                                    <arg value="pmd"/>
                                    <arg value="validate"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/pmd-report/pmd-scope.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/pmd-report/pom.xml"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>clean-stale-test-output</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target unless="skipTests">
                                <delete dir="${project.build.directory}/surefire-reports"
                                        quiet="true"/>
                                <delete dir="${project.build.directory}/failsafe-reports"
                                        quiet="true"/>
                                <delete file="${project.build.directory}/failsafe-summary.xml"
                                        quiet="true"/>
                                <delete file="${project.build.directory}/jacoco.exec"
                                        quiet="true"/>
                                <delete dir="${project.reporting.outputDirectory}/jacoco"
                                        quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>clean-stale-spotbugs-output</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.directory}/spotbugs/spotbugs-raw.xml"
                                        quiet="true"/>
                                <delete file="${project.build.directory}/spotbugs/spotbugs.xml"
                                        quiet="true"/>
                                <delete file="${project.build.directory}/spotbugs/spotbugs.html"
                                        quiet="true"/>
                                <delete file="${project.reporting.outputDirectory}/spotbugs.html"
                                        quiet="true"/>
                                <delete dir="${project.build.directory}/spotbugs-raw"
                                        quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>filter-spotbugs-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!--
                                  Operates on native raw XML and never re-runs bytecode analysis.
                                  Excluded projects have no raw XML and therefore produce no output.
                                -->
                                <java classname="SpotBugsReportFilter"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${maven.multiModuleProjectDirectory}/target/build-quality-verifier"/>
                                        <path refid="maven.plugin.classpath"/>
                                    </classpath>
                                    <arg value="${project.build.directory}/spotbugs-raw/spotbugs-raw.xml"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/target/build-quality/spotbugs-accepted-filter.xml"/>
                                    <arg value="${project.build.directory}/spotbugs/spotbugs.xml"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>render-spotbugs-html</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <xslt destdir="${project.build.directory}"
                                      extension=".html"
                                      failOnNoResources="false"
                                      useImplicitFileset="false"
                                      force="true">
                                    <fileset dir="${project.build.directory}"
                                             includes="spotbugs/spotbugs.xml"
                                             erroronmissingdir="false"/>
                                    <style>
                                        <javaresource name="default.xsl"
                                                      classpathref="maven.plugin.classpath"/>
                                    </style>
                                </xslt>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Keep last among quality plugins so child integrity executions see completed reports. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-hygiene</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Explicit release/scheduled security gate; intentionally not bound to the regular lifecycle. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
                    <failBuildOnUnusedSuppressionRule>true</failBuildOnUnusedSuppressionRule>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules: version aligned with the reactor. -->
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-errors</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-diagnostics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-etl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-concurrency</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-platform-diagnostics-logging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-application-tck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-regex-re2j</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-psl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-source-tika</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-csv</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-manifest-json-jackson</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-store-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-transport-smb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-ingest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-adapter-cli-picocli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iocextractor</groupId>
                <artifactId>ioc-app</artifactId>
