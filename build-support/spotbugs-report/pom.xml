<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iocextractor</groupId>
        <artifactId>ioc-extractor-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ioc-spotbugs-report</artifactId>
    <packaging>pom</packaging>
    <name>ioc-spotbugs-report</name>
    <description>Build-only aggregate SpotBugs report for the complete production reactor</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <!-- Platform production universe. -->
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-errors</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-diagnostics</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-etl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-events</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-concurrency</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-diagnostics-logging</artifactId>
        </dependency>

        <!-- Core production universe; application TCK is test support and excluded. -->
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-application</artifactId>
        </dependency>

        <!-- Adapter production universe. -->
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-regex-re2j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-psl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-source-tika</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-manifest-json-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-store-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-transport-smb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-ingest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-cli-picocli</artifactId>
        </dependency>

        <!-- Runnable composition root. -->
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-app</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <!-- Preserve the aggregate goal's Doxia HTML instead of applying the module XSLT. -->
                    <execution>
                        <id>filter-spotbugs-report</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>render-spotbugs-html</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-spotbugs-report-integrity</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="${java.home}/bin/java" failonerror="true">
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/build-quality/BuildQualityVerifier.java"/>
                                    <arg value="spotbugs"/>
                                    <arg value="verify-reports"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${project.basedir}/spotbugs-scope.tsv"/>
                                    <arg value="${project.basedir}/pom.xml"/>
                                </exec>
                                <java classname="SpotBugsBaselineVerifier"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${maven.multiModuleProjectDirectory}/target/build-quality-verifier"/>
                                    </classpath>
                                    <arg value="verify"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${project.basedir}/spotbugs-scope.tsv"/>
                                    <arg value="${project.basedir}/spotbugs-accepted-findings.xml"/>
                                    <arg value="${project.basedir}"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>create-reactor-spotbugs-raw-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>spotbugs-aggregate</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <skipEmptyReport>false</skipEmptyReport>
                            <outputDirectory>${project.build.directory}/spotbugs-raw</outputDirectory>
                            <spotbugsXmlOutputFilename>spotbugs-raw/spotbugs-raw.xml</spotbugsXmlOutputFilename>
                        </configuration>
                    </execution>
                    <execution>
                        <id>create-reactor-spotbugs-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>spotbugs-aggregate</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <skipEmptyReport>false</skipEmptyReport>
                            <outputDirectory>${project.build.directory}/spotbugs</outputDirectory>
                            <spotbugsXmlOutputFilename>spotbugs/spotbugs.xml</spotbugsXmlOutputFilename>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
