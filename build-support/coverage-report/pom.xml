<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iocextractor</groupId>
        <artifactId>ioc-extractor-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ioc-coverage-report</artifactId>
    <packaging>pom</packaging>
    <name>ioc-coverage-report</name>
    <description>Build-only aggregate JaCoCo report for the complete production reactor</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <!-- Platform production universe. -->
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-errors</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-diagnostics</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-etl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-events</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-concurrency</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-platform-diagnostics-logging</artifactId>
        </dependency>

        <!-- Core production universe; application TCK is test support and excluded. -->
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-application</artifactId>
        </dependency>

        <!-- Adapter production universe. -->
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-regex-re2j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-psl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-source-tika</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-manifest-json-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-store-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-transport-smb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-ingest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-adapter-cli-picocli</artifactId>
        </dependency>

        <!-- Runnable composition root. -->
        <dependency>
            <groupId>com.iocextractor</groupId>
            <artifactId>ioc-app</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Build-only POM: it validates reports but has no bytecode to analyze. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>create-reactor-coverage-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                            </formats>
                            <title>ioc-extractor reactor coverage</title>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-stale-aggregate-coverage-output</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target unless="skipTests">
                                <delete dir="${project.reporting.outputDirectory}/jacoco-aggregate"
                                        quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-test-lifecycle-report-union</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <java classname="TestLifecycleVerifier"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${maven.multiModuleProjectDirectory}/target/build-quality-verifier"/>
                                    </classpath>
                                    <arg value="verify-reports"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/test-quality/test-lifecycle.properties"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-coverage-policy</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <java classname="CoverageVerifier"
                                      fork="true"
                                      failonerror="true">
                                    <classpath>
                                        <pathelement location="${maven.multiModuleProjectDirectory}/target/build-quality-verifier"/>
                                    </classpath>
                                    <arg value="verify-reports"/>
                                    <arg value="${maven.multiModuleProjectDirectory}"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/coverage-report/coverage-scope.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/coverage-report/coverage-ratchets.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/coverage-report/coverage-floors.tsv"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/build-support/coverage-report/pom.xml"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
